# Copy to .env and adjust. All optional — sane defaults are used.
PORT=3000
# Secret for signing JWT. CHANGE in production.
JWT_SECRET=change-me-in-production
# Seeded on first run if no users exist.
ADMIN_USER=admin
ADMIN_PASS=admin123
# Max upload size in bytes (default 512 MB).
MAX_UPLOAD_BYTES=536870912
